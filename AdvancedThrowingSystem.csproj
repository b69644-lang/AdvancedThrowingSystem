<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>AdvancedThrowingSystem</AssemblyName>
    <RootNamespace>AdvancedThrowingSystem</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Set RDR2_DIR to the game's root folder before building. -->
    <Reference Include="ScriptHookRDRNetAPI">
      <HintPath>dependencies\ScriptHookRDRNetAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
